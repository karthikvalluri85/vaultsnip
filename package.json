{
  "name": "vaultsnip",
  "version": "0.7.0",
  "private": true,
  "description": "Turn sensitive report snips into client-safe replicas. Browser-only: masks sensitive text on your device and rebuilds dashboards with synthetic data.",
  "homepage": "https://vaultsnip.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karthikvalluri85/vaultsnip.git"
  },
  "bugs": {
    "url": "https://github.com/karthikvalluri85/vaultsnip/issues"
  },
  "author": "Karthik Valluri",
  "license": "Apache-2.0",
  "keywords": [
    "dashboard",
    "redaction",
    "privacy",
    "synthetic-data",
    "ocr",
    "bi",
    "tableau",
    "power-bi",
    "chrome-extension"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node tools/check.mjs",
    "e2e": "node tools/e2e.mjs",
    "build": "bash build.sh",
    "maps": "python3 tools/maps/build_maps.py",
    "test:unit": "vitest run",
    "fetch:model": "node tools/fetch-model.mjs",
    "build:ml": "node tools/build-ml.mjs",
    "test:ml-e2e": "node tests/e2e/ml-worker.e2e.mjs",
    "build:ext": "node tools/build-ext.mjs",
    "test:canvas-e2e": "node tests/e2e/canvas-ocr.e2e.mjs",
    "build:faker": "node tools/build-faker.mjs",
    "build:design": "node tools/build-design.mjs",
    "build:react": "node tools/build-react.mjs",
    "build:privacy": "node tools/build-privacy.mjs",
    "build:layout": "node tools/build-layout.mjs",
    "bench:fetch": "node tools/layout-bench/fetch.mjs",
    "bench:ocr": "node tools/layout-bench/ocr.mjs",
    "bench:layout": "node tools/layout-bench/run.mjs",
    "bench": "node tools/layout-bench/fetch.mjs && node tools/layout-bench/ocr.mjs && node tools/layout-bench/run.mjs",
    "bench:synth": "node tools/synth-bench/gen.mjs && node tools/synth-bench/run.mjs",
    "bench:gate": "node tools/bench-gate.mjs"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@huggingface/transformers": "4.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "echarts": "^6.1.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/roboto-slab": "5.3.0",
    "@types/chrome": "0.3.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "playwright": "1.63.0",
    "plotly.js-dist-min": "4.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.2",
    "vega": "6.4.0",
    "vega-lite": "6.4.3",
    "vite": "7.3.6",
    "vitest": "^5.0.5"
  }
}
