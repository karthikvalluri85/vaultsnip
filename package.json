{
  "name": "vaultsnip",
  "version": "0.5.2",
  "private": true,
  "description": "Turn sensitive report snips into client-safe replicas. Browser-only: masks sensitive text on your device and rebuilds dashboards with synthetic data.",
  "homepage": "https://vaultsnip.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karthikvalluri85/vaultsnip.git"
  },
  "bugs": {
    "url": "https://github.com/karthikvalluri85/vaultsnip/issues"
  },
  "author": "Karthik Valluri",
  "license": "Apache-2.0",
  "keywords": [
    "dashboard",
    "redaction",
    "privacy",
    "synthetic-data",
    "ocr",
    "bi",
    "tableau",
    "power-bi",
    "chrome-extension"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node tools/check.mjs",
    "e2e": "node tools/e2e.mjs",
    "build": "bash build.sh",
    "maps": "python3 tools/maps/build_maps.py",
    "build:wasm": "wasm-pack build src/core-rust --release --target web --out-dir ../../public/wasm --out-name vaultsnip_core",
    "test:rust": "cargo test --manifest-path src/core-rust/Cargo.toml",
    "test:unit": "vitest run",
    "fetch:model": "node tools/fetch-model.mjs",
    "build:ml": "vite build",
    "test:ml-e2e": "node tests/e2e/ml-worker.e2e.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "echarts": "^5.6.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "^5.9.2",
    "vite": "7.3.6",
    "vitest": "^3.2.4"
  }
}
