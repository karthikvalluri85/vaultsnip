{
  "manifest_version": 3,
  "name": "VaultSnip",
  "short_name": "VaultSnip",
  "version": "0.14.0",
  "description": "Blur sensitive text in any screenshot, on your device, in seconds. Free, offline, nothing sent or stored.",
  "action": {
    "default_title": "Snip this tab with VaultSnip",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "contextMenus"
  ],
  "commands": {
    "blur-canvases": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Blur text in charts on this page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
